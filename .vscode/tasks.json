{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "front: start",
      "type": "npm",
      "script": "start",
      "path": "front",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "front: test",
      "type": "npm",
      "script": "test",
      "path": "front",
      "problemMatcher": []
    },
    {
      "label": "back: start (Linux/macOS)",
      "type": "shell",
      "command": "set -a && . ../.env && set +a && ./mvnw spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/back" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "back: test (Linux/macOS)",
      "type": "shell",
      "command": "set -a && . ../.env && set +a && ./mvnw test",
      "options": { "cwd": "${workspaceFolder}/back" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "back: start (Windows)",
      "type": "shell",
      "command": "Get-Content ..\\.env | Where-Object { $_ -match '^[^#][^=]*=' } | ForEach-Object { $name, $value = $_ -split '=', 2; Set-Item -Path \"Env:$($name.Trim())\" -Value $value.Trim() }; .\\mvnw.cmd spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/back", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "back: test (Windows)",
      "type": "shell",
      "command": "Get-Content ..\\.env | Where-Object { $_ -match '^[^#][^=]*=' } | ForEach-Object { $name, $value = $_ -split '=', 2; Set-Item -Path \"Env:$($name.Trim())\" -Value $value.Trim() }; .\\mvnw.cmd test",
      "options": { "cwd": "${workspaceFolder}/back", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "database: start",
      "type": "shell",
      "command": "docker compose up -d db pgadmin",
      "problemMatcher": []
    }
  ]
}
